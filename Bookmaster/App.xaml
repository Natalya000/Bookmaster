<Application x:Class="Bookmaster.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Bookmaster"
             StartupUri="\View\Windows\MainWindow.xaml">
    <Application.Resources>
         <!-- Определяем раздел "словарь ресурсов-->
        <ResourceDictionary>
            <!--создание стилей для цвета -->
            <SolidColorBrush x:Key="LightGreen1" Color="#8FA43B"/>
            <SolidColorBrush x:Key="LightGreen2" Color="#718136"/>
            <SolidColorBrush x:Key="DarkGreen" Color="#50673B"/>
            <SolidColorBrush x:Key="Gray" Color="#BFBFBF"/>
            <!-- для подключения множества ресурсов определяем коллекцию MargeDictionaries-->
            <ResourceDictionary.MergedDictionaries>
                <!-- подключаем словари ресурсов-->
                <ResourceDictionary Source="\Styles\TextBlockStyle.xaml"/>
                <ResourceDictionary Source="\Styles\ButtonStyle.xaml"/>
                <ResourceDictionary Source="\Styles\TextBoxStyle.xaml"/>
                <ResourceDictionary Source="\Styles\CheckBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
