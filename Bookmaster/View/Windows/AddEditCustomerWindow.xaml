<Window x:Class="Bookmaster.View.Windows.AddEditCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bookmaster.View.Windows"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="1" Text="ID"/>
        <TextBox Name="IDTb" Grid.Row="1" Grid.ColumnSpan="3" Grid.Column="2"/>

        <TextBlock Grid.Row="3"  Text="Имя"/>
        <TextBox Name="NameTb" Grid.Row="3" Grid.ColumnSpan="3" Grid.Column="2"/>

        <TextBlock Grid.Row="5"  Text="Адресс"/>
        <TextBox Name="AdressTb" Grid.Row="5" Grid.ColumnSpan="3" Grid.Column="2"/>

        <TextBlock Grid.Row="7"  Text="Индекс/Город"/>
        <TextBox Name="ZipTb" Grid.Row="7" Grid.Column="2"/>
        <ComboBox Name="CityCmb"  Grid.Row="7" Grid.Column="4" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedIndex="0"/>

        <TextBlock Grid.Row="3" Grid.Column="6" Text="Телефон"/>
        <TextBox Name="PhoneTb" Grid.Row="3" Grid.ColumnSpan="3" Grid.Column="8"/>
        
        <TextBlock Grid.Row="5" Grid.Column="6" Text="Почта"/>
        <TextBox Name="EmailTb" Grid.Row="5" Grid.ColumnSpan="3" Grid.Column="8"/>

        <Button Name="SaveBtn" Grid.Row="9" Grid.Column="8" Content="Сохранить" Click="SaveBtn_Click"/>
        
        <Button Name="AddBtn" Grid.Row="9" Grid.Column="8" Content="Добавить" Click="AddBtn_Click"/>

        <Button Name="CancelBtn" Grid.Row="9" Grid.Column="10" Content="Отмена" Click="CancelBtn_Click"/>
    </Grid>
</Window>
